<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.petstore</groupId>
    <artifactId>order-processing-service</artifactId>
    <version>1.0.0</version>
    <name>order-processing-service</name>
    <description>Order Processing Center (legacy opc.ear): owns orders + workflow status,
        persists on consume, auto-approves, handles invoices, exposes the admin facade API.</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Hibernate Validator provider so @Valid on the admin-facade request bodies
             (e.g. updateOrders) is enforced; MethodArgumentNotValid → 400 via ApiExceptionHandler. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Versioned schema migrations for the authoritative order store. Replaces the
             old schema.sql/data.sql bootstrap; migrations live in db/migration
             (V1 = schema, V2 = seed) and run on startup against the file-based H2 DB. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-artemis</artifactId>
        </dependency>

        <!-- shared messaging (queues + InvoiceTopic + event envelope) -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>petstore-messaging</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- verify RS256 tokens from auth-service -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>auth-client</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- reuse the admin-facade DTOs/endpoint constants (single-sourced contract) -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>order-processing-client</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src</sourceDirectory>
        <testSourceDirectory>${project.basedir}/test</testSourceDirectory>
        <resources>
            <resource><directory>${project.basedir}/resources</directory></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
