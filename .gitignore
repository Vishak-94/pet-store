# ---- Secrets: never commit private keys (this is a PUBLIC repo) ----
# The RSA PRIVATE key is generated locally by ./generate-keys.sh and must NOT be
# committed. The PUBLIC key (petstore-auth-public.pem) is meant to be shared and
# IS committed so verifier services work out of the box.
auth-service/keys/private_key*.pem
auth-service/app/resources/auth-private-key.pem
