<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.sun.j2ee.blueprints</groupId>
    <artifactId>petstore-app-v1</artifactId>
    <version>1.0.0</version>
    <name>petstore-app-v1</name>
    <description>Java Pet Store storefront (v1) — migrated from J2EE 1.3 to Spring Boot 3.x on Java 21</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web + Thymeleaf (replaces JSF/JSP/WAF) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Bean Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Health / readiness probes + metrics — the storefront also hosts the shared
             broker, so an operational health endpoint matters here as much as anywhere.
             Matches the actuator setup the other 7 services already carry. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- NOTE: no JPA/H2 — the storefront persists nothing now. Like the legacy
             storefront, it builds the order and PUBLISHES it; order-processing-service
             (the OPC) is the authoritative order store. -->

        <!-- Importable client SDK for the customer-service microservice (domain data) -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>customer-service-client</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Central auth: login via auth-service (auth-client). The storefront no
             longer authenticates against customer-service. -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>auth-client</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Importable client SDK for the catalog-service microservice -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>catalog-service-client</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Embeddable cart library — runs IN-PROCESS (in-memory carts + TTL + logic),
             not a remote service. Pulls in catalog-service-client transitively. -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>cart-lib</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Security: form sign-on + logout (replaces legacy SignOnFilter/signoff.do) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Thymeleaf + Spring Security integration (sec:authorize / sec:authentication) -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JMS via ActiveMQ Artemis (KEEP JMS; replaces the JMS/MDB backbone). At runtime
             the storefront is a plain CLIENT of the externalized broker container
             (mode: native, broker-url); checkout publishes there. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-artemis</artifactId>
        </dependency>
        <!-- Artemis broker SERVER — TEST-ONLY (scope: test). In live, the broker is the
             standalone container (docker-compose.yml) and this app is a plain client
             (mode: native, embedded.enabled=false), so no in-VM broker is ever started
             in production. This dependency exists solely so @SpringBootTest can boot an
             in-VM embedded broker (test/resources/application.yml) and `mvn test` needs no
             running container. `scope: test` keeps it out of the shipped jar and makes the
             test-only nature build-enforced, not just documented.
             (History: the storefront used to HOST the shared broker via an embedded server
             + a TCP acceptor on :61616. That was removed when the broker was externalized —
             see git history for the deleted EmbeddedBrokerConfig.) -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>artemis-jakarta-server</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Shared messaging: destinations, event envelope, converter, publisher. -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>petstore-messaging</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Resilience: circuit breaker + bounded retry around the SDK calls
             (wired in HttpClientConfig via ResilientRestClient). Core modules only
             (no Spring Boot starter) — the resilience lives at the RestClient
             interceptor level, not via AOP annotations. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Custom (non-standard) layout: main sources under src/, tests under test/,
             resources under resources/. -->
        <sourceDirectory>${project.basedir}/src</sourceDirectory>
        <testSourceDirectory>${project.basedir}/test</testSourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/resources</directory>
            </resource>
        </resources>
        <!-- Test-only overrides (e.g. keep the Artemis broker embedded so @SpringBootTest
             needs no running broker container). Listed after main resources so the test
             application.yml wins on the classpath during the test phase. -->
        <testResources>
            <testResource>
                <directory>${project.basedir}/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
