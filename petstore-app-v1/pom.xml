<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.sun.j2ee.blueprints</groupId>
    <artifactId>petstore-app-v1</artifactId>
    <version>1.0.0</version>
    <name>petstore-app-v1</name>
    <description>Java Pet Store storefront (v1) — migrated from J2EE 1.3 to Spring Boot 3.x on Java 21</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web + Thymeleaf (replaces JSF/JSP/WAF) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Bean Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JPA persistence (replaces EJB 2.x CMP + Catalog DAO) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Importable client SDK for the customer-service microservice (domain data) -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>customer-service-client</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Central auth: login via auth-service (auth-client). The storefront no
             longer authenticates against customer-service. -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>auth-client</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Importable client SDK for the catalog-service microservice -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>catalog-service-client</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Embeddable cart library — runs IN-PROCESS (in-memory carts + TTL + logic),
             not a remote service. Pulls in catalog-service-client transitively. -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>cart-lib</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Security: form sign-on + logout (replaces legacy SignOnFilter/signoff.do) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Thymeleaf + Spring Security integration (sec:authorize / sec:authentication) -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 embedded DB (replaces Cloudscape) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JMS + embedded ActiveMQ Artemis (KEEP JMS; replaces the JMS/MDB backbone).
             Wired now so later phases (order/fulfilment) plug straight in. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-artemis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>artemis-jakarta-server</artifactId>
        </dependency>

        <!-- Shared messaging: destinations, event envelope, converter, publisher. -->
        <dependency>
            <groupId>com.petstore</groupId>
            <artifactId>petstore-messaging</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Custom (non-standard) layout: main sources under src/, tests under test/,
             resources under resources/. -->
        <sourceDirectory>${project.basedir}/src</sourceDirectory>
        <testSourceDirectory>${project.basedir}/test</testSourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
